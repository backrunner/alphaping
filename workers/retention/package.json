{
  "name": "@alphaping/worker-retention",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env= --config wrangler.retention.template.toml --outdir dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --config wrangler.retention.template.toml --test-scheduled",
    "test": "vitest run",
    "types": "wrangler types src/env.d.ts --include-runtime=false --config wrangler.retention.template.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.8.69",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
