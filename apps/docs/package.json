{
  "name": "@alphaping/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": "https://github.com/BackRunner/alphaping",
  "scripts": {
    "dev": "vite dev --port 4174",
    "build": "vite build && wrangler deploy --dry-run --env= --config wrangler.docs.template.toml --outdir dist",
    "preview": "vite preview --port 4174",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svedocs check --strict",
    "content:check": "svedocs check --strict"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.42.0",
    "svedocs": "0.2.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.0",
    "tailwindcss": "4.3.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svedocs-cli": "0.2.1",
    "@types/node": "26.4.1",
    "typescript": "catalog:",
    "vite": "8.2.2"
  }
}
