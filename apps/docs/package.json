{
  "name": "@alphaping/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": "https://github.com/BackRunner/alphaping",
  "scripts": {
    "dev": "vite dev --port 4174",
    "build": "vite build && wrangler deploy --dry-run --env= --config wrangler.docs.template.toml --outdir dist",
    "preview": "vite preview --port 4174",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svedocs check --strict",
    "content:check": "svedocs check --strict"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/svelte": "1.61.0",
    "svedocs": "0.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svedocs-cli": "0.3.0",
    "@types/node": "26.6.5",
    "typescript": "catalog:",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
