{
  "name": "@alphaping/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && wrangler deploy --dry-run --env= --config wrangler.web.template.toml --outdir dist",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "test": "vitest run --passWithNoTests",
    "types": "wrangler types src/worker-env.d.ts --include-runtime=false --env-file .dev.vars.example --config wrangler.web.template.toml"
  },
  "dependencies": {
    "@alphaping/authz": "workspace:*",
    "@alphaping/contracts": "workspace:*",
    "@alphaping/db": "workspace:*",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "better-auth": "1.6.23",
    "bits-ui": "2.18.1",
    "drizzle-orm": "0.45.2",
    "lucide-svelte": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.1.1",
    "svelte": "5.56.5",
    "svelte-check": "4.7.2",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:"
  }
}
