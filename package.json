{
  "name": "alphaping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": "https://github.com/alkinum/alphaping",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent:benchmark": "node scripts/check-agent-resources.mjs",
    "agent:build": "node scripts/run-cargo.mjs build -p alphaping-agent --release",
    "agent:package": "node scripts/release/package-agent.mjs",
    "agent:release:assemble": "node scripts/release/assemble-release.mjs",
    "agent:test": "node scripts/run-cargo.mjs test -p alphaping-agent",
    "build": "turbo run build",
    "check": "turbo run check",
    "cost:check": "node scripts/check-cost-model.mjs",
    "db:backup": "node scripts/d1-backup.mjs",
    "db:generate": "node scripts/generate-d1-schema.mjs write",
    "db:generate:check": "node scripts/generate-d1-schema.mjs check",
    "db:migrate:local": "node scripts/run-d1-migrations.mjs local",
    "db:restore:verify": "node scripts/d1-restore-verify.mjs",
    "db:validate": "node scripts/run-d1-migrations.mjs validate",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:scripts && turbo run test",
    "test:e2e": "node scripts/test-web-e2e.mjs && node scripts/test-ingest-e2e.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "turbo run check",
    "verify": "node scripts/verify.mjs",
    "workers:list": "node scripts/deploy-workers.mjs --list",
    "workers:deploy": "node scripts/deploy-workers.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260715.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.64.0",
    "vitest": "3.2.6",
    "wrangler": "4.111.0"
  }
}
